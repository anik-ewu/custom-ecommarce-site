# Copy to .env (git-ignored) and set your own values.
POSTGRES_DB=shop
POSTGRES_USER=shop
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
# Only for `docker compose --profile full up` (the API in a container):
AUTH_SIGNING_KEY=<at least 32 random characters, e.g. openssl rand -base64 48>
SEED_ADMIN_PASSWORD=
