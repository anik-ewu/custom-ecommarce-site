{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Shop": {
    "Name": "Kinbo",
    "StoreSlug": "kinbo",
    "ShippingFee": 120,
    "FreeShippingThreshold": 3000,
    "UtcOffsetHours": 6
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Seed": {
    "Enabled": true,
    "AdminEmail": "admin@kinbo.test",
    "DemoEmail": "demo@kinbo.test",
    "DemoAdminEmail": "demo-admin@kinbo.test"
  },
  "Auth": {
    "Issuer": "kinbo",
    "Audience": "kinbo",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "RateLimits": {
    "LoginPerMinute": 5,
    "RegisterPerMinute": 3
  },
  "Images": {
    "LocalPath": "App_Data/uploads",
    "CloudinaryFolder": "kinbo"
  }
}
